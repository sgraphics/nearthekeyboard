<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ntk_root"
    android:importantForAutofill="noExcludeDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ntk_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The header, as in the owner's mock: the small NTK mark at the left; at the right,
             the screen's name above NEAR THE KEYBOARD. The mark's gaps are ntk_display. -->
        <LinearLayout
            style="@style/NtkHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <tools.ntk.ui.BadgeView
                android:layout_width="wrap_content"
                android:layout_height="15dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView style="@style/NtkHeaderScreen" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="settings" />
                <TextView style="@style/NtkHeaderName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Near the keyboard" />
            </LinearLayout>
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/NtkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="24sp"
            android:text="A keyboard that lets you prove you typed a text by hand." />

        <TextView
            android:id="@+id/ntk_busy"
            style="@style/NtkSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Network: everything below follows it (tools.ntk.Network). -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Network" />
        <RadioGroup
            android:id="@+id/ntk_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/ntk_network_testnet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:buttonTint="@color/ntk_check_tint"
                android:textColor="@color/ntk_choice_text"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light"
                android:text="Testnet" />
            <RadioButton
                android:id="@+id/ntk_network_mainnet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:buttonTint="@color/ntk_check_tint"
                android:textColor="@color/ntk_choice_text"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light"
                android:text="Mainnet" />
        </RadioGroup>
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Each network keeps its own login, and you enroll on each. Testnet uses no real money." />

        <!-- 1. Keyboard -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1. Keyboard" />
        <TextView android:id="@+id/ntk_kb_status" style="@style/NtkBody"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/ntk_btn_enable" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Turn on NTK in system settings" />
        <Button android:id="@+id/ntk_btn_pick" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Switch to the NTK keyboard" />

        <!-- 2. NEAR account -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2. NEAR account" />
        <TextView android:id="@+id/ntk_account_status" style="@style/NtkBody"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/ntk_btn_wallet" style="@style/NtkButton.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log in with a NEAR wallet" />
        <Button android:id="@+id/ntk_btn_faucet" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Create a testnet account for me" />
        <Button android:id="@+id/ntk_btn_logout" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log out (deletes this phone's key)" />

        <!-- 3. Fingerprint -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3. Typing fingerprint" />
        <TextView android:id="@+id/ntk_enroll_status" style="@style/NtkBody"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/ntk_btn_enroll" style="@style/NtkButton.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Enroll: type three short texts" />
        <Button android:id="@+id/ntk_btn_status" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ask the enclave for my status" />
        <Button android:id="@+id/ntk_btn_forget" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Delete my fingerprint" />

        <!-- 4. Try it -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="4. Try it" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Type at least 40 keys here with NTK, then tap Sign on the keyboard. On a match the keyboard adds a tag like [NTK e65ee28db5] after your text." />
        <EditText
            android:id="@+id/ntk_try_field"
            style="@style/NtkField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type here"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences" />

        <!-- 5. Stamp buttons in other apps -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5. Stamp buttons in other apps" />
        <TextView android:id="@+id/ntk_a11y_status" style="@style/NtkBody"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="NTK can put a small NTK button on every stamp tag you see, like [NTK e65ee28db5], in any app. Tap it and your browser opens the page that checks the stamp.\n\nFor that, Android has to let NTK read what is on your screen: it is an accessibility service. NTK reads the screen on this phone only, to find tags. It stores nothing and sends nothing. Only when you tap a button, the browser gets the id of the stamp and the text in front of the tag, and that text stays in the browser.\n\nIn the settings, open NTK stamp buttons and switch it on." />
        <Button android:id="@+id/ntk_btn_a11y" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open accessibility settings" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Android 13 and later: if the switch is greyed out or says the setting is restricted, NTK was installed from outside an app store. Open App info, tap the three dots at the top right, choose Allow restricted settings, and try again." />
        <Button android:id="@+id/ntk_btn_app_info" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open App info" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Without the service: select a text with a tag in any app and choose Verify NTK stamp in the menu." />

        <!-- What is sent -->
        <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="What NTK sends, and when" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="While you type in a text field, the keyboard keeps, in memory only, per key tap: the key, how long it was held, the time since the previous key, and where your finger landed on it. Nothing leaves the phone until you tap Enroll or Sign. Then that one session is sealed on the phone to the NTK enclave's key (NEAR OutLayer, Intel TDX) and sent, signed with your NEAR account's key; only the enclave can open it. Your typing fingerprint stays inside the enclave. Password fields and incognito fields are never recorded. Delete my fingerprint removes it from the enclave." />

        <!-- Debug builds only -->
        <LinearLayout
            android:id="@+id/ntk_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView style="@style/NtkHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Debug build" />
            <TextView android:id="@+id/ntk_debug_transport" style="@style/NtkSmall"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/ntk_debug_relay"
                style="@style/NtkField"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:hint="Relay URL, for example http://localhost:3970/api" />
            <Button android:id="@+id/ntk_btn_use_relay" style="@style/NtkButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Use this relay" />
            <Button android:id="@+id/ntk_btn_use_direct" style="@style/NtkButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Call OutLayer directly (payment key from local.properties)" />
            <TextView android:id="@+id/ntk_debug_site" style="@style/NtkSmall"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/ntk_debug_site_url"
                style="@style/NtkField"
                android:minHeight="48dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:hint="Site for verify and login links, for example http://10.0.2.2:8080/" />
            <Button android:id="@+id/ntk_btn_use_site" style="@style/NtkButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Use this site (empty: https://ntk.tools/)" />
        </LinearLayout>

        <Button android:id="@+id/ntk_btn_settings" style="@style/NtkButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Keyboard settings" />
        <TextView style="@style/NtkSmall" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Built on Simple Keyboard (Apache-2.0). Stamps are signed by the NTK enclave on NEAR OutLayer testnet." />
    </LinearLayout>
    </LinearLayout>
</ScrollView>
