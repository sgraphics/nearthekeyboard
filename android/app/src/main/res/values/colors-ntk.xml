<!-- NTK: the light theme, high-key white as in the brand's reference scene. A white
     background; keys, buttons and cards are white blocks with very light cool-grey
     side faces (lit below, shaded at the right) and a soft blurred shadow, no
     outlines; function keys a touch greyer. Near-black legends; orange only on the
     Sign key and in the badge (TODO.md 3.7, 8). -->
<resources>
    <color name="ntk_background">#FFFFFFFF</color>
    <color name="ntk_grid">#FFEEF0F3</color>
    <color name="ntk_legend">#FF111418</color>
    <color name="ntk_muted">#FF6B7280</color>
    <color name="ntk_orange">#FFFF4F00</color>
    <color name="ntk_orange_lit">#FFE04600</color>
    <color name="ntk_orange_shade">#FFC23D00</color>
    <color name="ntk_on_orange">#FF111418</color>
    <color name="ntk_key_face">#FFFFFFFF</color>
    <color name="ntk_key_lit">#FFF3F4F6</color>
    <color name="ntk_key_shade">#FFE8EAED</color>
    <color name="ntk_key_func_face">#FFF5F6F8</color>
    <color name="ntk_key_func_lit">#FFEBEDF0</color>
    <color name="ntk_key_func_shade">#FFE0E3E7</color>
    <!-- The soft shadow under every block (blurred where the canvas can, API 28+). -->
