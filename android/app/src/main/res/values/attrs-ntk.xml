<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- tools.ntk.ui.TileDrawable (a flat tools.ntk.ui.Tile, up or pressed) and
         tools.ntk.ui.FloorDrawable (ntkFace and the ntkBase* attributes only). -->
    <declare-styleable name="NtkTile">
        <attr name="ntkState">
            <enum name="up" value="1" />
            <enum name="pressed" value="2" />
        </attr>
        <!-- The face's one colour, and its soft shadow's (pressed tiles have none). -->
        <attr name="ntkFace" format="color" />
        <attr name="ntkShadow" format="color" />
        <attr name="ntkRadius" format="dimension" />
        <attr name="ntkBlur" format="dimension" />
        <attr name="ntkDrop" format="dimension" />
        <!-- Where the face is: the bounds less these (the room its shadow fades out in). -->
        <attr name="ntkInsetLeft" format="dimension" />
        <attr name="ntkInsetTop" format="dimension" />
        <attr name="ntkInsetRight" format="dimension" />
        <attr name="ntkInsetBottom" format="dimension" />
        <!-- Content padding of views with this background. -->
        <attr name="ntkPaddingLeft" format="dimension" />
        <attr name="ntkPaddingTop" format="dimension" />
        <attr name="ntkPaddingRight" format="dimension" />
        <attr name="ntkPaddingBottom" format="dimension" />
        <!-- FloorDrawable: the base under the keys, a band of ntkBase (ntkBaseBand tall)
             over ntkBaseLow. -->
        <attr name="ntkBase" format="color" />
        <attr name="ntkBaseLow" format="color" />
        <attr name="ntkBaseBand" format="dimension" />
    </declare-styleable>
</resources>
