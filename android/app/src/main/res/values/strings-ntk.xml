<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="ntk_strip_height">44dp</dimen>
    <!-- Key tiles (tools.ntk.ui.TileDrawable): corner radius, the soft shadow's blur and
         drop, and the room the face leaves inside the key's bounds for the shadow to fade
         out in. Legends are centred on the face. Drawing only: keys keep their bounds. -->
    <dimen name="ntk_key_radius">8dp</dimen>
    <dimen name="ntk_key_blur">2dp</dimen>
    <dimen name="ntk_key_drop">0.75dp</dimen>
    <dimen name="ntk_key_inset_side">1dp</dimen>
    <dimen name="ntk_key_inset_top">0.5dp</dimen>
    <dimen name="ntk_key_inset_bottom">2.5dp</dimen>
    <!-- Lowercase letters large, as in the owner's mock (upstream: 55%). -->
    <fraction name="ntk_key_letter_ratio">64%</fraction>
    <!-- The small hint at a key's top right; a little smaller than upstream's 25% so it
         clears the capitals. -->
    <fraction name="ntk_key_hint_letter_ratio">22%</fraction>
    <string name="keyboard_theme_ntk" translatable="false">NTK (light and dark, follows the system)</string>

    <!-- The stamp buttons in other apps (accessibility service) and the text selection menu entry. -->
    <string name="ntk_a11y_label" translatable="false">NTK stamp buttons</string>
    <string name="ntk_a11y_description" translatable="false">Puts a small NTK button on every NTK stamp tag you see, such as [NTK e65ee28db5], in any app. To find tags, this service reads the text on your screen, on this phone only. It stores nothing and sends nothing. Only when you tap a button, the browser opens the verify page on ntk.tools with the stamp\'s id and the text in front of the tag; the text goes in the part of the address that browsers never send to a server.</string>
    <string name="ntk_verify_selection" translatable="false">Verify NTK stamp</string>
</resources>
