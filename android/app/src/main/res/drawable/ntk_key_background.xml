<?xml version="1.0" encoding="utf-8"?>
<!-- NTK keys: white tiles (TileDrawable). A press pushes the tile in; the Enter key
     (state_active) carries a short gold bar; a shift that is locked stays pushed in with
     the gold bar lit. Same bounds in every state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_empty="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:state_empty="true" android:drawable="@android:color/transparent" />
    <item android:state_active="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_action_pressed" />
    <item android:state_active="true" android:drawable="@drawable/ntk_key_action" />
    <item android:state_checkable="true" android:state_checked="true" android:drawable="@drawable/ntk_key_on" />
    <item android:state_checkable="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:state_checkable="true" android:drawable="@drawable/ntk_key_normal" />
    <item android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:drawable="@drawable/ntk_key_normal" />
</selector>
