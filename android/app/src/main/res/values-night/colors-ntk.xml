<?xml version="1.0" encoding="utf-8"?>
<!-- NTK, dark: the same layout in flat dark greys, thin light legends, the same orange. -->
<resources>
    <!-- Surfaces. -->
    <color name="ntk_background">#FF1D2026</color>
    <color name="ntk_floor">#FF1D2026</color>
    <!-- The strip and the app's header. The NTK mark's gaps are painted in ntk_display
         (drawable/ntk_badge_dark.xml): draw it only on it. -->
    <color name="ntk_display">#FF22252B</color>
    <color name="ntk_key">#FF272B32</color>
    <color name="ntk_key_pressed">#FF333842</color>
    <color name="ntk_key_shadow">#59000000</color>
    <color name="ntk_field">#FF22252B</color>

    <!-- Ink. -->
    <color name="ntk_legend">#FFE8EBF1</color>
    <color name="ntk_key_hint">#FFE8EBF1</color>
    <color name="ntk_muted">#FF8E98B1</color>
    <color name="ntk_muted_light">#FF4A5161</color>
    <color name="ntk_hint">#FF6E788F</color>

    <!-- The accent. -->
    <color name="ntk_orange">#FFFF4F00</color>
    <color name="ntk_accent">#FFFD5B15</color>
    <color name="ntk_accent_pressed">#FFE24E0F</color>
    <color name="ntk_on_accent">#FFFFFFFF</color>
    <!-- Over the keys while a Sign or Enroll call runs. -->
    <color name="ntk_veil">#B81D2026</color>

    <!-- The base under the keys. -->
    <color name="ntk_base">#FF2A2E36</color>
    <color name="ntk_base_low">#FF343A45</color>
</resources>
