# LF everywhere, on every OS. enclave/manifest.json is embedded byte for byte in
# the wasm, so its line endings are part of the code hash an attestation names.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.wasm binary
*.apk binary
*.jar binary
*.ttf binary
*.otf binary
*.woff2 binary
