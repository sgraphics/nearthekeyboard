<?xml version="1.0" encoding="utf-8"?>
<!-- NTK keys: flat tiles (TileDrawable), every key the same, Enter too. A press, and a
     shift that is locked, show the pressed colour without the shadow. Same bounds in
     every state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_empty="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:state_empty="true" android:drawable="@android:color/transparent" />
    <item android:state_checkable="true" android:state_checked="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:drawable="@drawable/ntk_key_normal" />
</selector>
