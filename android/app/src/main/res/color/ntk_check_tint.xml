<?xml version="1.0" encoding="utf-8"?>
<!-- Check boxes and radio buttons: black, orange when ticked, muted when not available. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ntk_muted_light" />
    <item android:state_checked="true" android:color="@color/ntk_accent" />
    <item android:color="@color/ntk_legend" />
</selector>
