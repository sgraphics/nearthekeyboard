<?xml version="1.0" encoding="utf-8"?>
<!-- NTK keys: blocks (PixelKeyDrawable, ntkBlock). A press moves the top face
     down onto its drop; a shift that is on stays down. Same bounds in every state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_empty="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:state_empty="true" android:drawable="@android:color/transparent" />
    <item android:state_active="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_func_pressed" />
    <item android:state_active="true" android:drawable="@drawable/ntk_key_func" />
    <item android:state_checkable="true" android:state_checked="true" android:drawable="@drawable/ntk_key_func_pressed" />
    <item android:state_checkable="true" android:state_pressed="true" android:drawable="@drawable/ntk_key_func_pressed" />
    <item android:state_checkable="true" android:drawable="@drawable/ntk_key_func" />
    <item android:state_pressed="true" android:drawable="@drawable/ntk_key_pressed" />
    <item android:drawable="@drawable/ntk_key_normal" />
</selector>
