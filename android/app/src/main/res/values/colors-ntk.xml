<?xml version="1.0" encoding="utf-8"?>
<!-- NTK, light: Dieter Rams, after the owner's mock. Flat surfaces of one colour each,
     no gradients, no outlines; keys are flat tiles with a barely visible soft shadow on
     a flat floor; thin black type; one accent, flat orange; muted greys for minor
     elements. The NTK mark keeps its own orange. -->
<resources>
    <!-- Surfaces. -->
    <color name="ntk_background">#FFE6EAF2</color>
    <color name="ntk_floor">#FFE6EAF2</color>
    <!-- The strip above the keys and the app's header. The NTK mark's gaps are painted
         in ntk_display (drawable/ntk_badge_light.xml): draw it only on it. -->
    <color name="ntk_display">#FFF3F6FC</color>
    <color name="ntk_key">#FFECEFF6</color>
    <color name="ntk_key_pressed">#FFDCE1EA</color>
    <color name="ntk_key_shadow">#1C1E2A3D</color>
    <color name="ntk_field">#FFF3F6FC</color>

    <!-- Ink. -->
    <color name="ntk_legend">#FF000000</color>
    <color name="ntk_key_hint">#FF000000</color>
    <color name="ntk_muted">#FF8E98B1</color>
    <color name="ntk_muted_light">#FFBDC3D3</color>
    <color name="ntk_hint">#FF8E98B1</color>

    <!-- The accent: flat orange (Sign, main actions, the meter's needle, the stamp
         buttons); ntk_orange is the NTK mark's own. -->
    <color name="ntk_orange">#FFFF4F00</color>
    <color name="ntk_accent">#FFFD5B15</color>
    <color name="ntk_accent_pressed">#FFE24E0F</color>
    <color name="ntk_on_accent">#FF000000</color>

    <!-- The base under the keys, where the system draws its navigation buttons. -->
    <color name="ntk_base">#FFBDC3D3</color>
    <color name="ntk_base_low">#FF8E98B1</color>
</resources>
