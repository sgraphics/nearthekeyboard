<?xml version="1.0" encoding="utf-8"?>
<!-- The app's header: a dark display, like the car's screen and the keyboard's strip. Its
     face is flat ntk_display, the colour the NTK mark's gaps are painted in. -->
<drawable xmlns:app="http://schemas.android.com/apk/res-auto"
    class="tools.ntk.ui.TileDrawable"
    app:ntkState="up"
    app:ntkFace="@color/ntk_display"
    app:ntkFaceBottom="@color/ntk_display"
    app:ntkHighlight="@color/ntk_display_edge"
    app:ntkShadow="@color/ntk_tile_shadow"
    app:ntkRadius="12dp"
    app:ntkLipHeight="0dp"
    app:ntkBlur="4dp"
    app:ntkHairline="1dp"
    app:ntkInsetLeft="3dp" app:ntkInsetTop="1dp" app:ntkInsetRight="4dp" app:ntkInsetBottom="8dp"
    app:ntkPaddingLeft="21dp" app:ntkPaddingTop="19dp" app:ntkPaddingRight="22dp" app:ntkPaddingBottom="26dp" />
